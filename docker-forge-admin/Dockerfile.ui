# ============================================
# Forge Admin UI 前端 Dockerfile
# ============================================
# 构建上下文为项目根目录，docker compose 中 context 设为 ..
FROM node:23-alpine AS builder
WORKDIR /app
COPY forge-admin-ui/package.json ./
RUN npm config get registry https://registry.npmmirror.com
COPY forge-admin-ui/ .
RUN npm install -g pnpm@9 && pnpm install && pnpm run build

FROM nginx:1.25-alpine
COPY --from=builder /app/dist /usr/share/nginx/html/forge
COPY docker-forge-admin/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
