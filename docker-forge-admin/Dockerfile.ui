# ============================================
# Forge Admin UI 前端 Dockerfile
# ============================================
# 构建上下文为项目根目录，docker compose 中 context 设为 ..
FROM node:20.19.5-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
COPY forge-admin-ui/package.json forge-admin-ui/pnpm-lock.yaml forge-admin-ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY forge-admin-ui/ .
RUN pnpm run build

FROM nginx:1.25-alpine
COPY --from=builder /app/dist /usr/share/nginx/html/forge
COPY docker-forge-admin/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
