<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志存放路径 -->
    <property name="log.path" value="./var/logs" />
    <property name="app.log.level" value="${FORGE_LOG_LEVEL:-INFO}" />
    <property name="sql.log.level" value="${FORGE_SQL_LOG_LEVEL:-INFO}" />
    <!-- 日志输出格式（包含traceId） -->
    <property name="log.pattern" value="traceId:[%X{traceId}], %d{HH:mm:ss.SSS} [%thread] %-5level %logger{20} - [%method,%line] - %msg%n" />
    <!-- 控制台输出 -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${log.pattern}</pattern>
        </encoder>
    </appender>
    
    <!-- 系统日志输出 -->
    <appender name="file_info" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/forge-admin.log</file>
        <!-- 循环政策：基于时间创建日志文件 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 日志文件名格式 -->
            <fileNamePattern>${log.path}/forge-admin-info.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 日志最大的历史 60天 -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
        </encoder>
    </appender>
    
    <!-- 应用默认使用 INFO；需要临时诊断时通过 FORGE_LOG_LEVEL 显式开启 DEBUG。 -->
    <logger name="com.mdframe.forge" level="${app.log.level}" additivity="false">
        <appender-ref ref="console" />
        <appender-ref ref="file_info" />
    </logger>
    <!-- SQL 默认不输出 DEBUG 明细；可通过 FORGE_SQL_LOG_LEVEL 单独开启。 -->
    <logger name="com.mdframe.forge.plugin.system.mapper" level="${sql.log.level}" />
    <logger name="com.mdframe.forge.plugin.generator.mapper" level="${sql.log.level}" />

    <root level="info">
        <appender-ref ref="console" />
        <appender-ref ref="file_info" />
    </root>
</configuration>
