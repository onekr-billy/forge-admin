	"tabBar": {
		"color": "#86909C",
		"selectedColor": "#4266F7",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "white",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页",
				"iconPath": "static/icons/ai-icon/home.svg",
				"selectedIconPath": "static/icons/ai-icon/home.svg"
			},
			{
				"pagePath": "pages/todo",
				"text": "待办",
				"iconPath": "static/icons/ai-icon/check-square.svg",
